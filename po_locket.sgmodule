#!url=https://raw.githubusercontent.com/quangtuan1207/my_locket.conf/refs/heads/main/po_locket.sgmodule
#!name=Locket Gold VIP - By Po
#!desc=Module Shadowrocket mở khóa Locket Gold VIP vĩnh viễn. Phát hành bởi quangtuan1207.
#!author=Po (quangtuan1207)

[Script]
# Mở khóa gói Locket Gold qua RevenueCat
revenuecat = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/quangtuan1207/my_locket.conf/refs/heads/main/locketpo.js, requires-body=true, max-size=-1, timeout=60

# Xóa ETag header để luôn nhận phản hồi mới từ RevenueCat
deleteHeader = type=http-request, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/quangtuan1207/my_locket.conf/refs/heads/main/deleteHeader.js, timeout=60

# Mở khóa toàn bộ Remote Config
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/quangtuan1207/my_locket.conf/refs/heads/main/locket_remote.js, requires-body=true, max-size=-1, timeout=60

# Giữ Huy hiệu Locket Gold luôn BẬT và đồng bộ thông tin tài khoản
locket_badge = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/changeProfileInfo, script-path=https://raw.githubusercontent.com/quangtuan1207/my_locket.conf/refs/heads/main/locket_profile.js, timeout=60
locket_user = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/.+, script-path=https://raw.githubusercontent.com/quangtuan1207/my_locket.conf/refs/heads/main/locket_profile.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com
